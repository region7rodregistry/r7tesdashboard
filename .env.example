# ─────────────────────────────────────────────────────────────────────────────
# NTTC Registry — environment configuration
#
# Copy this file to `.env.local` and fill in the values.
# The dashboard runs WITHOUT these vars (it falls back to the bundled
# data/records.json), but Supabase + Sync require them.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser — used for reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose to the browser).
# Used by /api/sync to overwrite the registry table.
SUPABASE_SERVICE_ROLE_KEY=

# The Google Sheet that the Sync button pulls from.
# The sheet (or the file) must be shared as "Anyone with the link can view".
# Tab: "as of June 2026"
GOOGLE_SHEET_ID=1TnNdv5nC_4PHjnws9aL6CpBd6Nvz--E3P3dZxRR37A4
GOOGLE_SHEET_GID=1031452427

# Optional shared secret. If set, /api/sync requires header `x-sync-secret`.
SYNC_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Login gate (shared admin credentials)
#
# The dashboard is protected by a single admin login. Set all three values,
# then restart the dev/prod server. AUTH_SECRET signs the session cookie —
# generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
